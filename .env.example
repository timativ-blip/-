# Переменные нужно передать процессу или через docker --env-file.
APP_ENV=production
ACCESS_CODE=replace-with-a-long-random-team-code
SESSION_SECRET=replace-with-at-least-32-random-characters
TIMEZONE=Europe/Moscow
DATABASE_PATH=data/exit_poll.sqlite3
PRECINCTS_FILE=precincts.json
REFUSAL_DEMOGRAPHICS=true
# Google Sheets: отдельный лист без сортировки/удаления строк.
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=Анкеты
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
# Необязательно: адаптер SMS по контракту в README. Только HTTPS.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
# Служебный номер, на который приложение подготовит аварийный SMS-код анкеты.
SMS_REQUEST_NUMBER=
